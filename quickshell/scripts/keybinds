#!/bin/sh
# keybinds — every bind in keybinds.conf (and any the user added in
# local.conf) as rows for the settings panel's Keybinds tab
# (quickshell/KeybindsPane.qml), one per line, tab-separated:
#   section  keys  description  where  kind  command
# keys: alternatives split by "|", each one "+"-joined keycaps.
# where: a line number in keybinds.conf, or local:N for local.conf.
# kind: run (an exec) or do (a sway command); command: what it runs, or
# the sway command as the file writes it.
#   keybinds              print the rows
#   keybinds open WHERE   open that file in geany at that line
# The tab's editor (keybinds.conf only; local.conf is yours by hand):
#   keybinds get N        line N as fields: mod  key  desc  run|do  value
#   keybinds set N MOD KEY DESC KIND VALUE      rewrite line N (and the
#                         "# desc" above it: replaced, added or dropped)
#   keybinds add SECTION MOD KEY DESC KIND VALUE   new bind at the end of
#                         "# --- SECTION ---"; prints the new line number
#   keybinds delete N     drop line N and its "# desc"
#   keybinds check        a chord bound twice in keybinds.conf, if any
#   keybinds apply        scripts/sway-reload
# Every write is tried through `check` first; a duplicate is refused and
# the file left alone. MOD is "super+shift" style ("none" for none); the
# file gets sway's names ($mod, Ctrl, Mod1 for Alt, Shift). A rewritten
# line keeps its flags (--whole-window and the like).
#
# What it reads from the files:
#   "# --- name ---"   starts a section (name ends at ":", "(" or "---")
#   "# Text"           right above a bind describes it; notes go above that.
#                      Above a run of back-to-back binds it's a note for the
#                      group, and each bind is labelled from its command.
# Binds with the same description in a section share a row (arrows and
# hjkl, XF86 keys and Super+F12), and runs of workspace binds fold into one.
C="${XDG_CONFIG_HOME:-$HOME/.config}/sway"
CONF="$C/keybinds.conf"
LOCAL="$C/local.conf"

if [ "$1" = open ]; then
    case "${2:-1}" in
        local:*) exec geany --line="${2#local:}" "$LOCAL" ;;
        *)       exec geany --line="${2:-1}" "$CONF" ;;
    esac
fi

# The parts of a bind line every verb needs, as awk functions: P() splits
# line s into P_type (bindsym, bindcode, bindgesture...), P_flags,
# P_combo (the chord or gesture) and P_cmd (the rest, spacing kept).
PARSE='
function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
function isbind(s) { return s ~ /^[ \t]*bind(sym|code|gesture|switch)[ \t]/ }
function isheader(s) { return s ~ /^#[ \t]*---/ }
function P(s,   t) {
    s = trim(s)
    P_type = substr(s, 1, index(s, " ") - 1); s = trim(substr(s, length(P_type) + 1))
    P_flags = ""
    while (s ~ /^--/) {
        t = substr(s, 1, (index(s, " ") ? index(s, " ") - 1 : length(s)))
        P_flags = P_flags (P_flags != "" ? " " : "") t
        s = trim(substr(s, length(t) + 1))
    }
    P_combo = substr(s, 1, (index(s, " ") ? index(s, " ") - 1 : length(s)))
    P_cmd = trim(substr(s, length(P_combo) + 1))
}
# a modifier as the editor names it, lower case
function modname(m,   l) {
    l = tolower(m)
    if (l == "$mod" || l == "mod4" || l == "super") return "super"
    if (l == "mod1" || l == "alt") return "alt"
    if (l == "ctrl" || l == "control") return "ctrl"
    return l
}
# the order of the modifiers in a chord: Super, Ctrl, Alt, Shift, then the rest
function modrank(m) { return m == "super" ? 1 : m == "ctrl" ? 2 : m == "alt" ? 3 : m == "shift" ? 4 : 5 m }
# the chord as "mods" (in that order, editor names) and the key
function chord(c,   n, a, i, j, t, m) {
    n = split(c, a, "+")
    C_key = a[n]
    for (i = 1; i < n; i++) a[i] = modname(a[i])
    for (i = 1; i < n; i++) for (j = i + 1; j < n; j++) if (modrank(a[j]) < modrank(a[i])) { t = a[i]; a[i] = a[j]; a[j] = t }
    m = ""
    for (i = 1; i < n; i++) m = m (m != "" ? "+" : "") a[i]
    C_mods = m
}
'

# ---- the editor's verbs ----
# bind line from fields: flags, mods (editor names), key, kind, value
fmt() {
    combo=""
    for m in $(printf '%s' "$2" | tr '+' ' '); do
        case "$m" in
            none) continue ;;
            super) m='$mod' ;;
            alt) m=Mod1 ;;
            ctrl) m=Ctrl ;;
            shift) m=Shift ;;
        esac
        combo="$combo$m+"
    done
    combo="$combo$3"
    flags="$1"; [ -n "$flags" ] && flags="$flags "
    if [ "$4" = run ]; then printf 'bindsym %s%s exec %s\n' "$flags" "$combo" "$5"
    else printf 'bindsym %s%s %s\n' "$flags" "$combo" "$5"; fi
}
# a chord bound twice refuses the candidate file (--release binds and
# gestures are their own; the order of the modifiers doesn't matter)
check() {
    awk "$PARSE"'
        isbind($0) {
            P($0); chord(P_combo)
            k = P_type SUBSEP (P_flags ~ /--release/ ? "release" : "") SUBSEP C_mods SUBSEP tolower(C_key)
            if (k in seen) { printf "key %s is bound twice (lines %d and %d)\n", P_combo, seen[k], NR > "/dev/stderr"; bad = 1 }
            else seen[k] = NR
        }
        END { exit bad }' "$1"
}
commit() { if check "$1"; then mv "$1" "$CONF"; else rm -f "$1"; return 1; fi; }
# the flags of line N, kept by a rewrite
flagsof() { awk "$PARSE"' NR == n { if (isbind($0)) { P($0); print P_flags } }' n="$1" "$CONF"; }
# the "# desc" line directly above a bind: a plain comment, not a header,
# and not a note for a run (the line after the bind is another bind)
case "${1:-}" in
get)
    exec awk "$PARSE"'
        { L[NR] = $0 }
        END {
            if (!isbind(L[n])) exit 1
            P(L[n]); chord(P_combo)
            mod = (C_mods != "" ? C_mods : "none")
            if (P_cmd ~ /^exec[ \t]/) { kind = "run"; val = trim(substr(P_cmd, 5)); sub(/^--no-startup-id[ \t]+/, "", val) }
            else { kind = "do"; val = P_cmd }
            desc = ""
            if (L[n-1] ~ /^#/ && !isheader(L[n-1]) && !isbind(L[n+1])) { desc = L[n-1]; sub(/^#+[ \t]*/, "", desc) }
            printf "%s\t%s\t%s\t%s\t%s\n", mod, C_key, desc, kind, val
        }' n="${2:?line}" "$CONF"
    ;;
set)
    n="${2:?line}"; line=$(fmt "$(flagsof "$n")" "$3" "$4" "$6" "$7"); desc="$5"; tmp="$CONF.tmp"
    awk "$PARSE"'
        { L[NR] = $0 }
        END {
            hasdesc = (L[n-1] ~ /^#/ && !isheader(L[n-1]) && !isbind(L[n+1]))
            for (i = 1; i <= NR; i++) {
                if (i == n - 1 && hasdesc) { if (d != "") print "# " d; continue }
                if (i == n) { if (!hasdesc && d != "") print "# " d; print l; continue }
                print L[i]
            }
        }' n="$n" l="$line" d="$desc" "$CONF" > "$tmp"
    commit "$tmp" || exit 1
    echo "$n"
    ;;
add)
    sec="${2:?section}"; line=$(fmt "" "$3" "$4" "$6" "$7"); desc="$5"; tmp="$CONF.tmp"
    ins=$(awk -v sec="$sec" '
        /^#[ \t]*---/ { s = $0; sub(/^#[ \t]*---[ \t]*/, "", s); sub(/[ \t]*(---|:|\().*$/, "", s)
                       insec = (tolower(s) == tolower(sec)); if (insec) last = NR; next }
        insec && !/^[ \t]*$/ { last = NR }
        END { print last + 0 }' "$CONF")
    extra=0; [ -n "$desc" ] && extra=1
    if [ "$ins" -gt 0 ]; then
        awk -v n="$ins" -v l="$line" -v d="$desc" '{ print } NR == n { if (d != "") print "# " d; print l }' "$CONF" > "$tmp"
        newline=$((ins + 1 + extra))
    else
        { cat "$CONF"; printf '\n# --- %s ---\n' "$sec"; [ -n "$desc" ] && printf '# %s\n' "$desc"; printf '%s\n' "$line"; } > "$tmp"
        newline=$(($(wc -l < "$CONF") + 3 + extra))
    fi
    commit "$tmp" || exit 1
    echo "$newline"
    ;;
delete)
    n="${2:?line}"; tmp="$CONF.tmp"
    awk "$PARSE"'
        { L[NR] = $0 }
        END {
            hasdesc = (L[n-1] ~ /^#/ && !isheader(L[n-1]) && !isbind(L[n+1]))
            for (i = 1; i <= NR; i++) { if (i == n || (hasdesc && i == n - 1)) continue; print L[i] }
        }' n="$n" "$CONF" > "$tmp"
    commit "$tmp" || exit 1
    ;;
check)  check "$CONF" ;;
apply)  exec "$(dirname "$(readlink -f "$0")")/sway-reload" ;;
esac
[ -z "${1:-}" ] || exit 0

# local.conf only when it exists (a user may delete it)
set --
[ -f "$LOCAL" ] && set -- "$LOCAL"
exec awk "$PARSE"'
function cap(m) { return m == "" ? "" : toupper(substr(m, 1, 1)) substr(m, 2) }
function mods(m,   n, a, i, out) {
    if (m == "") return ""
    n = split(m, a, "+")
    for (i = 1; i <= n; i++) out = out (out != "" ? "+" : "") cap(a[i])
    return out
}
function keyname(k) {
    if (k in K) return K[k]
    if (length(k) == 1) return toupper(k)
    sub(/^XF86/, "", k)
    return k
}
function combo(m, k) { m = mods(m); return m != "" ? m "+" k : k }

# a row label from the sway command, when no "# Text" describes it
function label(c,   a, n) {
    n = split(c, a, /[ \t]+/)
    if (a[1] == "exec") { c = a[2]; if (c == "--no-startup-id") c = a[3]; sub(/^.*\//, "", c); return c }
    if (c ~ /^focus (left|right|up|down)$/)  return "Focus " a[2]
    if (c ~ /^move (left|right|up|down)$/)   return "Move window " a[2]
    if (c ~ /^focus output /)                return "Focus monitor " a[3]
    if (c ~ /^move container to output /)    return "Send window to monitor " a[5]
    if (c ~ /^resize (grow|shrink) /)        return cap(a[2]) " " a[3]
    if (c ~ /^focus (next|prev) sibling$/)   return (a[2] == "prev" ? "Previous" : "Next") " window in this container"
    if (c ~ /^workspace (next|prev)_on_output$/) return (a[2] ~ /^prev/ ? "Previous" : "Next") " workspace"
    if (c == "kill")                         return "Close window"
    if (c ~ /^floating toggle/)              return "Toggle floating"
    if (c == "fullscreen" || c == "fullscreen toggle") return "Fullscreen"
    if (c == "balance")                      return "Balance window sizes"
    if (c == "reload")                       return "Reload config"
    if (c == "exit")                         return "Quit sway"
    return c
}

# workspace N / move to workspace N: fold a run into one row
function foldkind(c) {
    if (c ~ /^workspace (number )?[0-9]+$/) return "view"
    if (c ~ /^move (container )?(to )?workspace (number )?[0-9]+$/) return "tag"
    return ""
}
function foldnum(c) { sub(/^.*[^0-9]/, "", c); return c }
function folddesc(kind, a, b,   ws) {
    ws = (a == b) ? a : a "–" b
    return kind == "view" ? "View workspace " ws : "Move window to workspace " ws
}

BEGIN {
    K["Return"] = "Enter"; K["space"] = "Space"; K["Tab"] = "Tab"; K["Escape"] = "Esc"
    K["Left"] = "←"; K["Right"] = "→"; K["Up"] = "↑"; K["Down"] = "↓"
    K["grave"] = "`"; K["comma"] = ","; K["period"] = "."; K["slash"] = "/"
    K["minus"] = "-"; K["equal"] = "="; K["semicolon"] = ";"; K["apostrophe"] = "\047"
    K["bracketleft"] = "["; K["bracketright"] = "]"; K["backslash"] = "\\"
    K["plus"] = "Plus"; K["BackSpace"] = "Backspace"; K["Delete"] = "Del"; K["Print"] = "PrtSc"
    K["XF86AudioRaiseVolume"] = "Vol Up"; K["XF86AudioLowerVolume"] = "Vol Down"
    K["XF86AudioMute"] = "Mute"; K["XF86AudioMicMute"] = "Mic Mute"
    K["XF86MonBrightnessUp"] = "Brightness Up"; K["XF86MonBrightnessDown"] = "Brightness Down"
    K["button1"] = "Left click"; K["button2"] = "Middle click"; K["button3"] = "Right click"
    K["button4"] = "Scroll up"; K["button5"] = "Scroll down"
}

# local.conf is read after keybinds.conf; its binds land in a "local"
# section (headers in it are ignored) and open there.
FNR == 1 && NR > 1 { islocal = 1; L[NR] = "# --- local ---" ; W[NR] = "local:0"; NR++ }
{ L[NR] = $0; W[NR] = (islocal ? "local:" FNR : FNR) }

END {
    section = "other"; nrows = 0; lastfold = 0
    for (i = 1; i <= NR; i++) {
        line = L[i]
        if (isheader(line)) {
            s = line
            sub(/^#[ \t]*---[ \t]*/, "", s)
            sub(/[ \t]*(---|:|\().*$/, "", s)
            section = s
            continue
        }
        if (!isbind(line)) { if (line !~ /^#/) lastfold = 0; continue }

        P(line)
        if (P_type == "bindgesture") {
            n = split(P_combo, g, ":")
            keys = (n >= 3) ? g[2] "-finger " g[1] " " g[3] : P_combo
            fmods = ""
        } else {
            chord(P_combo)
            keys = combo(C_mods, keyname(C_key))
            fmods = C_mods
        }

        fk = foldkind(P_cmd)
        if (fk != "") {
            fid = section SUBSEP fmods SUBSEP fk
            if (lastfold && FOLD[lastfold] == fid) {
                FKEYS[lastfold] = FKEYS[lastfold] " " keyname(C_key)
                FLAST[lastfold] = foldnum(P_cmd)
                continue
            }
            nrows++
            SEC[nrows] = section; LINE[nrows] = W[i]; KIND[nrows] = "do"; CMD[nrows] = P_cmd
            FOLD[nrows] = fid; FMODS[nrows] = fmods; FACT[nrows] = fk
            FKEYS[nrows] = keyname(C_key); FFIRST[nrows] = foldnum(P_cmd); FLAST[nrows] = foldnum(P_cmd)
            lastfold = nrows
            continue
        }
        lastfold = 0

        desc = ""
        if (L[i-1] ~ /^#/ && !isheader(L[i-1]) && !isbind(L[i+1])) {
            desc = L[i-1]
            sub(/^#+[ \t]*/, "", desc)
        }
        if (desc == "") desc = label(P_cmd)

        k = section SUBSEP desc
        if (k in SEEN) { KEYS[SEEN[k]] = KEYS[SEEN[k]] "|" keys; continue }
        nrows++
        SEEN[k] = nrows
        SEC[nrows] = section; KEYS[nrows] = keys; DESC[nrows] = desc; LINE[nrows] = W[i]
        if (P_cmd ~ /^exec[ \t]/) { KIND[nrows] = "run"; c = trim(substr(P_cmd, 5)); sub(/^--no-startup-id[ \t]+/, "", c); CMD[nrows] = c }
        else { KIND[nrows] = "do"; CMD[nrows] = P_cmd }
    }

    for (r = 1; r <= nrows; r++) {
        if (r in FOLD) {
            fk = FKEYS[r]
            sub(/1 2 3 4 5 6 7 8 9/, "1…9", fk)
            KEYS[r] = combo(FMODS[r], fk)
            DESC[r] = folddesc(FACT[r], FFIRST[r], FLAST[r])
        }
        printf "%s\t%s\t%s\t%s\t%s\t%s\n", SEC[r], KEYS[r], DESC[r], LINE[r], KIND[r], CMD[r]
    }
}
' "$CONF" "$@"
