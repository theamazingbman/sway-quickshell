#!/bin/sh
# sway-reload — reload sway's config. The bar's gaps and border width live
# in the state folder's tweaks.conf, which the config includes, so a reload
# keeps them with nothing to re-apply.
SHARE="$(dirname "$(dirname "$(readlink -f "$0")")")"

"$SHARE/scripts/sway-ipc" reload >/dev/null 2>&1 || true
